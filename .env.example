# Referencia; el instalador genera .env con valores aleatorios privados.
# No copies estas etiquetas como credenciales reales.
LOYALTY_HTTP_PORT=8097
STAGING_INSTANCE_ID=GENERADO_POR_EL_INSTALADOR
STAGING_DATABASE_PASSWORD=GENERADO_POR_EL_INSTALADOR
STAGING_IDENTITY_PEPPER=GENERADO_POR_EL_INSTALADOR
STAGING_ADMIN_TOKEN=GENERADO_POR_EL_INSTALADOR
STAGING_OWNER_TOKEN=GENERADO_POR_EL_INSTALADOR
STAGING_CASHIER_TOKEN=GENERADO_POR_EL_INSTALADOR
# Solo validación interna del piloto heredado; el registro actual no pide contraseña.
STAGING_ALICE_PASSWORD=GENERADO_POR_EL_INSTALADOR
STAGING_BOB_PASSWORD=GENERADO_POR_EL_INSTALADOR
# La configuración Apple/Google se crea separadamente en .env.wallet.
