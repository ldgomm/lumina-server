[Unit]
Description=Lumina portal candidate %i
After=network-online.target lumina-wallet@%i.service
Wants=network-online.target lumina-wallet@%i.service
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=lumina
Group=lumina
EnvironmentFile=/etc/lumina/slots/%i.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 ${RELEASE}/scripts/production.py serve --config /etc/lumina/production.json --release ${RELEASE} --slot %i --component portal
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lumina
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
